# Окружение и кэш
.venv/
__pycache__/
*.py[cod]
.ruff_cache/

# Данные и артефакты прогонов (data/raw, data/runs/<run>, ...)
data/*
!data/.gitkeep

# Глобальные маски артефактов
*.parquet
*.pq
*.csv
*.npz
*.npy
*.cbm
catboost_info/

# Ноутбуки
.ipynb_checkpoints/

# Логи
logs/
*.log

# Vim swap files
*.sw[a-p]

# Замороженный val-сплит ранкера — нужен для воспроизводимости, хранится в git
!data/splits/
!data/splits/*.csv
